# CampusIQ 360 — API environment
# Copy to server/.env and fill in. Never commit the real .env.

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campusiq?retryWrites=true&w=majority

# JWT signing secret — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRE=7d

# CORS — the deployed frontend origin allowed to call this API.
# Leave unset locally to allow all origins; ALWAYS set it in production.
FRONTEND_URL=http://localhost:5173

# Optional: additional allowed origins, comma-separated (e.g. preview deploys)
CORS_EXTRA_ORIGINS=
